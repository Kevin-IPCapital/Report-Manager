NCENTRAL_API_BASE_URL=ncentral.ipdimension.net
NCENTRAL_API_TOKEN=
# Optional; only used by test_connection.py. Falls back to NCENTRAL_API_TOKEN.
NCENTRAL_JWT=

# Required only by ncentral_availability.py (the availability collector).
# Point this at its own database — everything is created inside an `ncentral`
# schema and nothing outside that schema is read or written.
NCENTRAL_PG_DSN=postgresql://user:password@host:5432/dbname
