# Cove Data Protection collector. Copy to .env and fill in; never commit .env.
COVE_USERNAME=api-user@example.com
COVE_PASSWORD=change-me
COVE_PARTNER=Your Partner Name
COVE_PG_DSN=postgresql://user:password@localhost:5432/database
# The original names Login and SECRET_KEY are still read if the COVE_ ones are not set.
