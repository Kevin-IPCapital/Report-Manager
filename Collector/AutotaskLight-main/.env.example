AUTOTASK_USERNAME=apiuser@example.com
AUTOTASK_SECRET=your_api_user_secret
AUTOTASK_INTEGRATION_CODE=your_api_integration_code

# Optional. If omitted, the client will call zoneInformation and discover it.
# Example: https://webservices19.autotask.net/atservicesrest/
AUTOTASK_BASE_URL=

# Required only by autotask_db.py (the PostgreSQL loader).
AUTOTASK_PG_DSN=postgresql://user:password@localhost:5432/ipc_reporting
