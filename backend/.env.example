# Real environment variables override this file. Values are read as-is: no inline comments,
# and special characters in passwords must be percent-encoded (@ -> %40, : -> %3A, / -> %2F).

DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=1   # development only. Unset or 0 means production mode
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Application database: Django users and refresh tokens (tables created by `python manage.py migrate`).
DATABASE_URL=postgres://report_manager:change-me@localhost:5432/report_manager
# DATABASE_URL=sqlite:///db.sqlite3

# Reporting database: where the ticket and score data lives. Optional; leave blank to keep the dummy data.
REPORTS_DATABASE_URL=
# Used only by `manage.py test`. Leave blank to test on a temporary database on DATABASE_URL's server (the role needs CREATEDB).
# To test without PostgreSQL at all, use a SQLite URL: tests then run in memory.
# TEST_DATABASE_URL=sqlite:///test.sqlite3

# Accounts. FRONTEND_URL is the address of the web app, used in password-reset links.
FRONTEND_URL=http://localhost:5173
# DJANGO_REGISTRATION_OPEN=1
# Emails print to the backend console by default. For SMTP, set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# and the EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD, EMAIL_USE_TLS=1 values below.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=Report Manager <no-reply@example.com>

# ---- Development switches (only honoured while DJANGO_DEBUG=1) ----
# Login accepts ANY username and password while this is on. OFF by default; set 1 to turn it on for local development.
# Without it, register an account on the sign-in page (registration is open in debug) or run `manage.py createsuperuser`.
# DJANGO_DEV_LOGIN_BYPASS=1
# Let any signed-in user open the Data Collection page and queue collector runs. Off by default.
# Preferred instead: python manage.py makestaff <username>
# DJANGO_DEV_COLLECTOR_HEALTH_FOR_ALL=1

# ---- Collector alerts ----
# Comma-separated recipients for failure and missed-run emails. Needs working EMAIL_* settings above (or the console backend to test).
# COLLECTOR_ALERT_EMAILS=ops@example.com,manager@example.com
# COLLECTOR_HEARTBEAT_MAX_MINUTES=5
# COLLECTOR_ALERT_REPEAT_HOURS=24
# COLLECTOR_ALERT_ON_PARTIAL=0

# ---- Production (DJANGO_DEBUG=0) ----
# HTTPS redirect and HSTS are on. Behind a reverse proxy that terminates HTTPS, also set DJANGO_BEHIND_PROXY=1.
# DJANGO_SSL_REDIRECT=1
# DJANGO_BEHIND_PROXY=1
# Sign-in throttling: failed attempts allowed per address and username within the window.
# THROTTLE_MAX_ATTEMPTS=5
# THROTTLE_WINDOW_SECONDS=900
