  device_poll [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2B3D89"><TR><TD COLSPAN="2" BGCOLOR="#2B3D89"><FONT COLOR="white"><B>device_poll</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>poll_id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>device_id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">polled_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT">reporting</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">last_scan</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT">scan_age_mins</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">numeric</FONT></TD></TR><TR><TD ALIGN="LEFT">monitor_count</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">breach_count</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">error</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">imported_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR></TABLE>>];
  perf_check [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2B3D89"><TR><TD COLSPAN="2" BGCOLOR="#2B3D89"><FONT COLOR="white"><B>perf_check</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>device_id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>task_id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">module</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">task_ident</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">service_id</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">stale_after_mins</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">first_seen</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT">last_seen</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT">imported_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR></TABLE>>];
  perf_event [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2B3D89"><TR><TD COLSPAN="2" BGCOLOR="#2B3D89"><FONT COLOR="white"><B>perf_event</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>event_id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB">device_id <FONT COLOR="#2B3D89" POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB">task_id <FONT COLOR="#2B3D89" POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">transition_time</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT">state</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">state_class</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">in_active_issue</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">flap_suspected</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB">first_seen_poll <FONT COLOR="#2B3D89" POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">recorded_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT">imported_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR></TABLE>>];
  metric_run [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2B3D89"><TR><TD COLSPAN="2" BGCOLOR="#2B3D89"><FONT COLOR="white"><B>metric_run</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>run_id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">started_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT">finished_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT">org_unit_id</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">device_count</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">sample_count</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">new_count</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">stale_count</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">missing_count</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">ok</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">error</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">imported_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR></TABLE>>];
  perf_sample [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2B3D89"><TR><TD COLSPAN="2" BGCOLOR="#2B3D89"><FONT COLOR="white"><B>perf_sample</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>device_id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>sampled_at</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT">collected_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB">run_id <FONT COLOR="#2B3D89" POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">device_name</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">customer_name</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">site_id</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">site_name</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">cpu_pct</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">numeric</FONT></TD></TR><TR><TD ALIGN="LEFT">memory_pct</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">numeric</FONT></TD></TR><TR><TD ALIGN="LEFT">memory_total_mb</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">memory_used_mb</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">disks</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT">payload</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT">imported_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR></TABLE>>];
  patch_run [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2B3D89"><TR><TD COLSPAN="2" BGCOLOR="#2B3D89"><FONT COLOR="white"><B>patch_run</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>run_id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">started_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT">finished_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT">org_unit_id</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">device_count</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">patched_device_count</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">entry_count</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">missing_count</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">ok</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">error</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">imported_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR></TABLE>>];
  device_patch [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2B3D89"><TR><TD COLSPAN="2" BGCOLOR="#2B3D89"><FONT COLOR="white"><B>device_patch</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>run_id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>device_id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">captured_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT">device_name</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">device_class</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">os</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">customer_name</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">site_name</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">coverage</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">entry_count</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">installed_count</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">missing_count</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">missing_security_count</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">missing_windows_count</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">missing_thirdparty_count</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">missing_definition_count</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">last_installed_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT">days_since_last_install</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">numeric</FONT></TD></TR><TR><TD ALIGN="LEFT">undated_installed_count</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">patch_monitor_states</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT">reboot_monitor_state</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">error</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">imported_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR></TABLE>>];
  patch_entry [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2B3D89"><TR><TD COLSPAN="2" BGCOLOR="#2B3D89"><FONT COLOR="white"><B>patch_entry</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>run_id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>device_id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>title</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">category</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">category_id</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">result</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">is_missing</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">is_security</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">is_third_party</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">installed_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT">kb</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">imported_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR></TABLE>>];
  patch_backlog [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2B3D89"><TR><TD COLSPAN="2" BGCOLOR="#2B3D89"><FONT COLOR="white"><B>patch_backlog</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>device_id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>title</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">device_name</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">customer_name</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">category</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">is_security</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">is_third_party</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">kb</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">first_missing_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT">last_missing_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT">times_seen_missing</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">resolved_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT">imported_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR></TABLE>>];
  poll_run -> device_poll [label="poll_id", style=solid, arrowhead=crow, arrowtail=none];
  device -> device_poll [label="device_id", style=solid, arrowhead=crow, arrowtail=none];
  device -> perf_check [label="device_id", style=solid, arrowhead=crow, arrowtail=none];
  poll_run -> perf_event [label="first_seen_poll", style=solid, arrowhead=crow, arrowtail=none];
  perf_check -> perf_event [label="device_id, task_id", style=solid, arrowhead=crow, arrowtail=none];
  metric_run -> perf_sample [label="run_id", style=solid, arrowhead=crow, arrowtail=none];
  patch_run -> device_patch [label="run_id", style=solid, arrowhead=crow, arrowtail=none];
  patch_run -> patch_entry [label="run_id", style=solid, arrowhead=crow, arrowtail=none];
  customers -> device [label="org_unit_id", style=dashed, arrowhead=crow, arrowtail=none];
  sites -> device [label="site_id", style=dashed, arrowhead=crow, arrowtail=none];
  device -> device_patch [label="device_id", style=dashed, arrowhead=crow, arrowtail=none];
  device_patch -> patch_entry [label="run_id, device_id", style=dashed, arrowhead=crow, arrowtail=none];
  customers -> patch_run [label="org_unit_id", style=dashed, arrowhead=crow, arrowtail=none];
}
