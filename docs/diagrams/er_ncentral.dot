digraph ER {
  graph [rankdir=LR, bgcolor="white", nodesep=.35, ranksep=.9, pad=.3, fontname="DejaVu Sans", label=<<B>N-central schema</B>>, labelloc=t, fontsize=16];
  node [shape=plain, fontname="DejaVu Sans", fontsize=10];
  edge [color="#697896", fontname="DejaVu Sans", fontsize=8, arrowsize=.7];
  customers [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2B3D89"><TR><TD COLSPAN="2" BGCOLOR="#2B3D89"><FONT COLOR="white"><B>customers</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>org_unit_id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">customer_name</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">imported_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR></TABLE>>];
  sites [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2B3D89"><TR><TD COLSPAN="2" BGCOLOR="#2B3D89"><FONT COLOR="white"><B>sites</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>site_id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">site_name</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">parent_id</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">customer_id</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">customer_name</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">imported_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR></TABLE>>];
