erDiagram
  customers {
    bigint id PK
  }
  snapshot {
    bigint snapshot_id PK
  }
  customer_month {
    bigint snapshot_id PK, FK
    text customer_name PK
  }
  threat {
    bigint snapshot_id PK, FK
    text threat_id PK
    text customer_name FK
  }
  agent {
    bigint snapshot_id PK, FK
    text agent_id PK
    text customer_name FK
  }
  threat_class {
    bigint snapshot_id PK, FK
    text customer_name PK, FK
    text classification PK
  }
  mitre_tactic {
    bigint snapshot_id PK, FK
    text customer_name PK, FK
    text tactic PK
  }
  top_threat {
    bigint snapshot_id PK, FK
    text customer_name PK, FK
    text threat_name PK
  }
  top_device {
    bigint snapshot_id PK, FK
    text customer_name PK, FK
    text device_name PK
  }
  top_user {
    bigint snapshot_id PK, FK
    text customer_name PK, FK
    text process_user PK
  }
  lolbin {
    bigint snapshot_id PK, FK
    text customer_name PK, FK
    text threat_name PK
  }
  daily_trend {
    bigint snapshot_id PK, FK
    text customer_name PK, FK
    date trend_date PK
  }
  os_spread {
    bigint snapshot_id PK, FK
    text customer_name PK, FK
    text os_name PK
  }
  agent_version {
    bigint snapshot_id PK, FK
    text customer_name PK, FK
    text agent_version PK
  }
  snapshot ||--o{ customer_month : "snapshot_id"
