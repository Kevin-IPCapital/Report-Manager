digraph ER {
  graph [rankdir=LR, bgcolor="white", nodesep=.35, ranksep=.9, pad=.3, fontname="DejaVu Sans", label=<<B>Cove schema</B>>, labelloc=t, fontsize=16];
  node [shape=plain, fontname="DejaVu Sans", fontsize=10];
  edge [color="#697896", fontname="DejaVu Sans", fontsize=8, arrowsize=.7];
  customers [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2B3D89"><TR><TD COLSPAN="2" BGCOLOR="#2B3D89"><FONT COLOR="white"><B>customers</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">customer_name</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">imported_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR></TABLE>>];
  snapshot [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2B3D89"><TR><TD COLSPAN="2" BGCOLOR="#2B3D89"><FONT COLOR="white"><B>snapshot</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>snapshot_id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">captured_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">source</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">customer_filter</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">device_count</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">notes</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">imported_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR></TABLE>>];
  device [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2B3D89"><TR><TD COLSPAN="2" BGCOLOR="#2B3D89"><FONT COLOR="white"><B>device</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>snapshot_id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>device_id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">device_name</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">device_alias</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">customer</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">contact_email</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">hostname</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">os</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">os_type</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">account_type</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">client_version</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">client_old</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">os_eol</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">is_server</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">is_m365</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">used_storage_bytes</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">dedup_efficiency</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">storage_location</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">strict_location_policy</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">reporting_enabled</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">reporting_frequency</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">dr_testing</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">immutable_enabled</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">fips_enabled</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">passphrase_set</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">lsv_enabled</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">lsv_status</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">cloud_status</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">retention_days</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">last_success</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">days_since_success</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">health</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">red_flag_count</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">active_datasources</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">imported_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR></TABLE>>];
  datasource_session [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2B3D89"><TR><TD COLSPAN="2" BGCOLOR="#2B3D89"><FONT COLOR="white"><B>datasource_session</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>snapshot_id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>device_id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>ds_code</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">ds_name</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">customer</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">device_name</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">status_code</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">error_count</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">duration_seconds</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">sent_bytes</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">protected_bytes</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">item_count</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">retention_days</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">last_success</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">last_session</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">colorbar_raw</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">ok_days</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">failed_days</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">warning_days</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">missed_days</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">max_fail_streak</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">recurring_failures</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">chronic_warnings</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">chronic_missed</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">imm_active</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">imm_last_status</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">imm_last_status_code</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">imm_last_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">imported_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR></TABLE>>];
  m365_source [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2B3D89"><TR><TD COLSPAN="2" BGCOLOR="#2B3D89"><FONT COLOR="white"><B>m365_source</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>snapshot_id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>device_id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>source_label</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">ds_code</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">customer</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">device_name</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">enabled</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">coverage</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">status_code</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">last_success</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">item_count</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">user_count</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">ok_days</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">failed_days</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">missed_days</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">imported_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR></TABLE>>];
  red_flag [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2B3D89"><TR><TD COLSPAN="2" BGCOLOR="#2B3D89"><FONT COLOR="white"><B>red_flag</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>red_flag_id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB">snapshot_id <FONT COLOR="#2B3D89" POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB">device_id <FONT COLOR="#2B3D89" POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">customer</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">device_name</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">category</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">flag</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">imported_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR></TABLE>>];
  snapshot -> device [label="snapshot_id", style=solid, arrowhead=crow, arrowtail=none];
  device -> datasource_session [label="snapshot_id, device_id", style=solid, arrowhead=crow, arrowtail=none];
  device -> m365_source [label="snapshot_id, device_id", style=solid, arrowhead=crow, arrowtail=none];
  device -> red_flag [label="snapshot_id, device_id", style=solid, arrowhead=crow, arrowtail=none];
}
