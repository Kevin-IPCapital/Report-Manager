  api_clientgroup [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2B3D89"><TR><TD COLSPAN="2" BGCOLOR="#2B3D89"><FONT COLOR="white"><B>api_clientgroup</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB">company_id <FONT COLOR="#2B3D89" POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">all_clients</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">clients</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">members</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR></TABLE>>];
  auth_user [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2B3D89"><TR><TD COLSPAN="2" BGCOLOR="#2B3D89"><FONT COLOR="white"><B>auth_user</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">is_staff</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR></TABLE>>];
