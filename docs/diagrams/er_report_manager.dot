  api_refreshtoken [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2B3D89"><TR><TD COLSPAN="2" BGCOLOR="#2B3D89"><FONT COLOR="white"><B>api_refreshtoken</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB">user_id <FONT COLOR="#2B3D89" POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">integer</FONT></TD></TR><TR><TD ALIGN="LEFT">family</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT">token_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">family_expires_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">rotated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">revoked</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR></TABLE>>];
  api_client [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2B3D89"><TR><TD COLSPAN="2" BGCOLOR="#2B3D89"><FONT COLOR="white"><B>api_client</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">contact_email</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">notes</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">text</FONT></TD></TR><TR><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB">company_id <FONT COLOR="#2B3D89" POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR></TABLE>>];
  api_clientsourcemap [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2B3D89"><TR><TD COLSPAN="2" BGCOLOR="#2B3D89"><FONT COLOR="white"><B>api_clientsourcemap</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB">client_id <FONT COLOR="#2B3D89" POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">source</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">external_id</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">varchar</FONT></TD></TR></TABLE>>];
