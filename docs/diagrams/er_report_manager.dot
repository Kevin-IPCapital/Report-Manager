  api_patchsnapshot [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2B3D89"><TR><TD COLSPAN="2" BGCOLOR="#2B3D89"><FONT COLOR="white"><B>api_patchsnapshot</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><B>id</B> <FONT COLOR="#2B3D89" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">run_id</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EEF1FB">client_id <FONT COLOR="#2B3D89" POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#EEF1FB"><FONT COLOR="#697896">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT">captured_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT">source</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT">weights</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT">components</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT">scores</TD><TD ALIGN="LEFT"><FONT COLOR="#697896">jsonb</FONT></TD></TR></TABLE>>];
